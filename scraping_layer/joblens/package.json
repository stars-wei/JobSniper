{
	"name": "joblens",
	"version": "1.10.0",
	"description": "A custom browser extension for collecting recruitment intelligence.",
	"bin": {
		"joblens": "./dist/cli.cjs"
	},
	"files": [
		"dist"
	],
	"exports": {
		".": "./dist/cli.cjs",
		"./api": "./dist/api.mjs"
	},
	"scripts": {
		"feat": "npm version patch --no-git-tag-version && npm run dev:chrome",
		"dev:chrome": "webpack --watch --env BROWSER=chrome --mode development",
		"build:chrome": "webpack --env BROWSER=chrome --mode production",
		"build": "npm run build:chrome",
		"dev": "npm run dev:chrome",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@types/chrome": "^0.0.270",
		"@types/dompurify": "^3.0.5",
		"@types/node": "^25.4.0",
		"@types/webextension-polyfill": "^0.12.1",
		"@types/webpack-env": "^1.18.5",
		"copy-webpack-plugin": "^14.0.0",
		"css-loader": "^7.1.2",
		"dotenv": "^16.4.1",
		"esbuild": "^0.25.0",
		"mini-css-extract-plugin": "^2.9.1",
		"sass": "^1.77.8",
		"sass-loader": "^16.0.1",
		"ts-loader": "^9.5.1",
		"ts-node": "^10.9.2",
		"typescript": "^5.5.4",
		"vitest": "^4.0.18",
		"webextension-polyfill": "^0.12.0",
		"webpack": "^5.97.1",
		"webpack-cli": "^5.1.4",
		"zip-webpack-plugin": "^4.0.1"
	},
	"dependencies": {
		"dayjs": "^1.11.13",
		"defuddle": "^0.17.0",
		"dompurify": "^3.0.9",
		"highlight.js": "^11.11.1",
		"linkedom": "^0.18.0",
		"lucide": "^0.359.0",
		"lz-string": "^1.5.0"
	}
}
