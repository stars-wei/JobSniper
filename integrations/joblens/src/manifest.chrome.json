{
	"manifest_version": 3,
	"name": "Joblens",
	"homepage_url": "https://github.com/stars-wei/obsidian-clipper",
	"version": "1.10.0",
	"description": "Collect recruitment intelligence from job platforms.",
	"permissions": [
		"activeTab",
		"storage",
		"scripting",
		"downloads"
	],
	"host_permissions": [
		"<all_urls>",
		"http://*/*",
		"https://*/*"
	],
	"action": {
		"default_title": "Joblens"
	},
	"icons": {
		"16": "icons/icon16.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"background": {
		"service_worker": "background.js"
	},
	"content_scripts": [
		{
			"matches": ["http://*/*", "https://*/*"],
			"js": ["browser-polyfill.min.js", "content.js"]
		}
	],
	"content_security_policy": {
		"extension_pages": "script-src 'self'; object-src 'self'"
	}
}
